# Required: Google AI Studio key for Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.1-flash-lite   # model used by every agent
# GEMINI_TEMPERATURE=0.2               # low = consistent, rule-following output
# GEMINI_RPM_LIMIT=15                  # requests/minute your key allows (free tier is 15)
# KB_BACKEND=chroma                    # "chroma" (semantic) or "lexical" (offline, no embedding model)
# DATABASE_URL=sqlite:///./kycompass.db
